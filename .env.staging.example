# =========================================================================
# NTMK REBUILD PHASE 02D — SUPABASE STAGING CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# =========================================================================

# Application environment
NODE_ENV=staging
PORT=3000

# 1. Supabase Project REST API Endpoint & Service Role Key
# Obtain from: Supabase Console -> Project Settings -> API
SUPABASE_URL=https://<your-staging-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-staging-service-role-secret-key>

# 2. PostgreSQL Connection URL (Direct or Transaction Pooler)
# For Vercel Serverless: Use Transaction Pooler (Port 6543)
# For Migrations / Dedicated Servers: Use Direct Connection (Port 5432)
# Obtain from: Supabase Console -> Project Settings -> Database -> Connection String
DATABASE_URL=postgresql://postgres.<your-ref>:<your-db-password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true
PG_POOL_MAX=10

# 3. System Operator Administrative Secret Key (For infrastructure & sync operations)
# Must be at least 32 characters, randomly generated
ADMIN_API_KEY=ntmk_staging_adm_sec_2026_change_me_to_random_32_bytes

# 4. Optional: Test Fixture Reviewer (For automated testing only)
# ADMIN_REVIEWER_ID=fixture_lead_curriculum_01
